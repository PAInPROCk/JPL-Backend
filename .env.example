# ==============================================================================
# AUCTRA / JPL BACKEND ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and replace placeholder values with your actual config:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase API & Authentication
# ------------------------------------------------------------------------------
# Base HTTPS URL of your Supabase Project (Project Settings -> API)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase Public Anon Key (JWT used for public client-side authentication)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Admin JWT bypassing RLS - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (Used for fast local symmetric JWT decoding / verification)
# (Project Settings -> API -> JWT Settings -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# (Optional) JWKS URL for asymmetric public key token verification
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 2. Supabase Storage Bucket
# ------------------------------------------------------------------------------
# Name of public storage bucket for player photos and team logos
SUPABASE_STORAGE_BUCKET=auctra-uploads

# ------------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database (Connection Pooler)
# ------------------------------------------------------------------------------
# Supabase Pooler host (Project Settings -> Database -> Connection string)
# Use Transaction Mode (port 6543) or Session Mode (port 5432)
SUPABASE_DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.<your-project-ref>
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_DB_NAME=postgres

# ------------------------------------------------------------------------------
# 4. Legacy / Fallback MySQL Settings (Optional / Compatibility)
# ------------------------------------------------------------------------------
MYSQLHOST=127.0.0.1
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=jpl